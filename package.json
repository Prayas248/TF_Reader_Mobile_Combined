{
  "name": "tf-reader-mobile-team1",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "a11y:build-spike-fixtures": "npx tsx src/features/accessibility/scripts/generateA11ySpikeFixtures.ts",
    "reader:build-html": "npx tsx src/features/reader/scripts/buildReaderHtml.ts",
    "reader:build-sample": "npx tsx src/features/reader/scripts/generateSampleEpub.ts",
    "reader:build-sample-index": "npx tsx src/features/reader/scripts/buildSampleSearchIndex.ts",
    "reader:build-sample-pdf": "npx tsx src/features/reader/scripts/generateSamplePdf.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "test:integration": "EXPO_PUBLIC_API_URL=http://localhost:8080 EXPO_PUBLIC_USER_ID=test-integration-user EXPO_PUBLIC_BOOK_ID=test-integration-book jest --testPathPattern='\\.integration\\.test\\.ts$' --testPathIgnorePatterns='/node_modules/'",
    "test:integration:download": "jest --testPathPattern='downloadManager\\.integration\\.test\\.ts$' --testPathIgnorePatterns='/node_modules/'"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/shared/contracts/**",
      "!src/gallery/**",
      "!src/**/*.gallery.{ts,tsx}",
      "!src/**/index.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 83,
        "functions": 88,
        "lines": 93,
        "statements": 90
      }
    },
    "moduleNameMapper": {
      "\\.epub$": "<rootDir>/jest.assetStub.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.test\\.ts$"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-aes-gcm-crypto"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^20.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "babel-plugin-module-resolver": "^5.0.0",
    "epubjs": "^0.3.93",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "eslint-import-resolver-typescript": "3.10.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "js-yaml": "^4.3.1",
    "jsdom": "^20.0.3",
    "patch-package": "^8.0.1",
    "pdfjs-dist": "3.11.174",
    "prettier": "^3.9.6",
    "sql.js": "^1.14.1",
    "tsx": "4.23.12",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@expo-google-fonts/aleo": "^0.4.2",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@iternio/react-native-tts": "^5.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "^57.0.12",
    "expo-asset": "~57.0.10",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "jszip": "^3.10.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-aes-gcm-crypto": "^0.2.2",
    "react-native-keychain": "^10.0.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.14"
  }
}
